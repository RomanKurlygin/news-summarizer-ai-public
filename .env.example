# Конфигурация FastAPI
APP_NAME="NewsSummarizer AI"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# JSON-массив origin, например ["http://localhost:8501"]
CORS_ORIGINS=[]
LOG_LEVEL=INFO
LOG_DIR=logs

# SQLAlchemy, таймауты в секундах
DATABASE_URL=
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_HEALTH_TIMEOUT=2

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# 0 отключает кэш. В Compose по умолчанию 900 секунд.
BASELINE_CACHE_TTL_SECONDS=0
# Для Compose задайте отдельный пароль в виде случайной hex-строки.
POSTGRES_PASSWORD=

# RAG
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=news_knowledge_base
QDRANT_MODE=local
RAG_INDEX_DIR=data/indexes
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=
EMBEDDING_SIZE=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=24
EMBEDDING_CACHE_DIR=.cache/sentence-transformers
EMBEDDING_LOCAL_FILES_ONLY=false

# LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Для compose.windows.yaml. Контейнеры обращаются к Ollama на Windows.
NEWS_HOST_OLLAMA_URL=http://host.docker.internal:11434
NEWS_OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_KEEP_ALIVE=10m
HF_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
HF_MODEL_REVISION=
HF_LLM_CACHE_DIR=.cache/llm
HF_LLM_LOCAL_FILES_ONLY=false
HF_LLM_MAX_INPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=2
LLM_RETRY_DELAY_SECONDS=1
LLM_ALLOW_LOCAL_FALLBACK=false
SUMMARIZER_TEMPERATURE=0.15
CRITIC_TEMPERATURE=0
EDITOR_TEMPERATURE=0.1
SUMMARIZER_MAX_TOKENS=180
CRITIC_MAX_TOKENS=480
EDITOR_MAX_TOKENS=180
API_RUN_TIMEOUT_SECONDS=120
API_GROUP_TIMEOUT_SECONDS=300
HOLDOUT_PATH=data/test/news_test.json
METRIC_NLTK_DIR=.cache/nltk
# ANTHROPIC_API_KEY и GEMINI_API_KEY задаются в окружении процесса, вне .env.
ANTHROPIC_MODEL=
GEMINI_MODEL=

# Аутентификация
# Сгенерируйте уникальный секрет для окружения: secrets.token_urlsafe(64)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
